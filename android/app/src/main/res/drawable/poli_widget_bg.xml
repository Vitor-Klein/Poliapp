<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: degrade roxo escuro -> roxo menos escuro -->
    <item>
        <shape>
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#2E1065"
                android:endColor="#5B21B6" />
        </shape>
    </item>

    <!-- brilho suave no topo -->
    <item>
        <shape>
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- borda sutil -->
    <item>
        <shape>
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>

</layer-list>
